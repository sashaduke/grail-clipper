use clipper;

fn compare_d<a, b>(n: u64, got: (&a clipper::PathD[]), want: (&b u64[])) -> u64 {
    mut w = u64[got.len()];
    for i in got.len() {
        w.push(got[i].x.len());
        for j in got[i].x.len() {
            w.push(bits(got[i].x[j]));
            w.push(bits(got[i].y[j]));
        }
    }
    if w.len() != want.len() {
        println("offset case {}: {} words, expected {}", n, w.len(), want.len());
        return 1;
    }
    for i in w.len() {
        if w[i] != want[i] {
            println("offset case {}: word {} differs", n, i);
            return 1;
        }
    }
    return 0;
}

