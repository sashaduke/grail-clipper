use clipper;

fn dfs<a>(t: (&a clipper::Tree), node: u64, out: (&a mut u64[])) {
    for i in clipper::tree_count(&t) {
        if t.parent[i] == node {
            out.push(i);
            dfs(&t, i, &mut out);
        }
    }
}
fn compare_tree<a, b>(n: u64, t: (&a clipper::Tree), want: (&b u64[])) -> u64 {
    mut order = u64[];
    dfs(&t, 0, &mut order);
    mut got = u64[order.len()];
    for k in order.len() {
        i := order[k];
        got.push(clipper::tree_level(&t, i));
        mut h: u64 = 0;
        if clipper::tree_is_hole(&t, i) {
            h = 1;
        }
        got.push(h);
        got.push(t.x[i].len());
        for j in t.x[i].len() {
            got.push(bits(t.x[i][j]));
            got.push(bits(t.y[i][j]));
        }
    }
    if got.len() != want.len() {
        println("tree case {}: {} words, expected {}", n, got.len(), want.len());
        return 1;
    }
    for i in got.len() {
        if got[i] != want[i] {
            println("tree case {}: word {} differs", n, i);
            return 1;
        }
    }
    return 0;
}

