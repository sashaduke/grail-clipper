use clipper;

fn compare<a, b>(n: u64, got: (&a clipper::Path[]), want: (&b clipper::Path[])) -> u64 {
    if got.len() != want.len() {
        println("case {}: {} paths, expected {}", n, got.len(), want.len());
        return 1;
    }
    for i in got.len() {
        if got[i].x.len() != want[i].x.len() {
            println("case {}: path {} has {} points, expected {}", n, i, got[i].x.len(), want[i].x.len());
            return 1;
        }
        for j in got[i].x.len() {
            if (got[i].x[j] != want[i].x[j]) || (got[i].y[j] != want[i].y[j]) {
                println("case {}: path {} point {} differs", n, i, j);
                return 1;
            }
        }
    }
    return 0;
}

